{
  "name": "ngx-highlightjs-project",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "start-mobile": "ng serve --host 0.0.0.0",
    "build": "ng build ngx-highlightjs-demo --ssr=false --prerender=false",
    "build-ssr": "ng build ngx-highlightjs-demo",
    "watch": "ng build --watch --configuration development",
    "build-lib": "ng build ngx-highlightjs",
    "lint-lib": "ng lint ngx-highlightjs",
    "test-lib": "ng test ngx-highlightjs",
    "test-lib-headless": "ng test ngx-highlightjs --watch=false --no-progress --browsers=ChromeHeadless --code-coverage",
    "serve:ssr:ngx-highlightjs-demo": "node dist/ngx-highlightjs-demo/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/cdk": "^21.2.10",
